# Copier en .env (non versionné)

# Réseau Bitcoin : regtest (dev, Docker) ou signet (démo publique)
BTC_NETWORK=regtest
ESPLORA_URL_REGTEST=http://localhost:3000
ESPLORA_URL_SIGNET=https://blockstream.info/signet/api

# Services mockés (processus séparés, stockage dans services/<nom>/data/)
SWISSQUOTE_PORT=4001
PARTNER_PORT=4002
WEB_PORT=5173

# Délais (secondes) : démo courte, valeur de production affichée dans l'UI
RECOVERY_DELAY_SECONDS=30
HIGH_VALUE_DELAY_SECONDS=20
PRODUCTION_RECOVERY_DELAY_LABEL=7 days

# Règles du cosignataire (sats)
DAILY_LIMIT_SATS=50000

# WebAuthn
RP_ID=localhost
RP_NAME=Swissquote Wallet (MOCK)
ORIGIN=http://localhost:5173
