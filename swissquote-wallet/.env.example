# Copy to .env (not versioned), next to this file.

# Bitcoin network: signet (public test network, used for the demo, no Docker needed)
# or regtest (local Docker network, for development: npm run regtest:up)
BTC_NETWORK=signet
ESPLORA_URL_SIGNET=https://blockstream.info/signet/api
ESPLORA_URL_REGTEST=http://localhost:3000

# Mocked services (separate processes, storage in services/<name>/data/)
SWISSQUOTE_PORT=4001
PARTNER_PORT=4002
WEB_PORT=5173

# Delays (seconds): short for the demo; the production value is shown in the UI
RECOVERY_DELAY_SECONDS=30
HIGH_VALUE_DELAY_SECONDS=20
PRODUCTION_RECOVERY_DELAY_LABEL=7 days

# Cosigner rules (sats): amount signed at once per 24 h, fees included.
# Signet faucets give small amounts: 3000 sats lets the demo show a held payment.
DAILY_LIMIT_SATS=3000

# WebAuthn
RP_ID=localhost
RP_NAME=Swissquote Wallet (MOCK)
ORIGIN=http://localhost:5173
